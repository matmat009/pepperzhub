APP_NAME=PepperzHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Must match the public origin exactly in production, including https://.
# The `public` disk builds its image URLs from this, so product photos and
# payment QR codes 404 if it is wrong.
APP_URL=http://localhost:8000

# Public email recovery stays off until a reliable provider passes delivery testing.
AUTH_PASSWORD_RESET_ENABLED=false
# Keep the login challenge active while preventing Settings from changing 2FA.
AUTH_TWO_FACTOR_SETTINGS_LOCKED=true
# Keep the admin interface light-only for now; set true to restore its appearance selector.
ADMIN_DARK_MODE_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
# Philippine market: seeded demo data reads as local rather than US.
APP_FAKER_LOCALE=en_PH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL, not the Laravel default of sqlite — this is what the app actually runs
# on in development and production. Fill in per environment.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pepperzhub
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email delivery is paused. Optional provider settings are documented in
# DEPLOYMENT.md and credentials belong only in each environment's private .env.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_REQUIRE_TLS=false
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="PepperzHub"

# Unused: no disk in config/filesystems.php targets S3. Kept as Laravel ships
# them, in case object storage is ever added.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
